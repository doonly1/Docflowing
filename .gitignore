# Word文档（不推送）
*.docx
*.pdf
*.pptx
*.xlsx
*.xls
*.ppt
*.doc

# Python缓存
__pycache__/
*.pyc

# 临时文件
~$*
temp*

# 工作区（含运行时用户配置、P2P 身份、图标等）
workspaces/

# Node.js（迁移到 pywebview 后不再需要）
node_modules/
package-lock.json
.npmrc

# 前端 lib（由 postinstall 自动生成）
ui/lib/

# 桌面壳构建输出（pywebview）
release/
dist/
build/

# PyInstaller 中间文件
build/

# NSIS 脚本（build-desktop.py 运行时生成，含本机绝对路径）
installer.nsi

# 构建日志
build_log.txt
error_log.txt

# 其他
electron/backend.spec
/.*/
!/.git/
!/.github/
