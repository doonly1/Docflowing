# Word文档（不推送）
*.docx
*.pdf
*.pptx
*.xlsx
*.xls
*.ppt
*.doc

# Python缓存
__pycache__/
*.pyc

# 临时文件
~$*
temp*

# 工作区（含运行时用户配置、P2P 身份、图标等）
workspaces/

# Node.js
node_modules/

# 前端 lib（由 postinstall 自动生成）
ui/lib/

# Electron 构建输出
release/
dist/

# PyInstaller 中间文件
build/

# 构建日志
build_log.txt
error_log.txt

# 其他
electron/backend.spec
/.*/
!/.git/
!/.github/
