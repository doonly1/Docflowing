{
  "name": "docflowing",
  "version": "1.0.0",
  "description": "文澜 Docflowing — 文档工作流桌面应用（pywebview）",
  "scripts": {
    "start": "python desktop_app.py",
    "dev": "set DOCFLOWING_DEV=1 && python desktop_app.py",
    "postinstall": "node electron/copy-libs.js",
    "build:desktop": "python electron/build-desktop.py",
    "build:backend": "python electron/build-backend.py"
  },
  "dependencies": {
    "iconv-lite": "^0.7.2",
    "marked": "^15.0.0",
    "quill": "^2.0.3",
    "turndown": "^7.2.0"
  }
}
